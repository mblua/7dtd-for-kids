<configs>

  <!-- ============================================================ -->
  <!-- 7 Days For Kids — Loading Screen Cover                       -->
  <!-- V3.x: pnlBlack is now a <fullscreencollider> without depth,  -->
  <!-- so the old "move pnlBlack above the image" trick no longer   -->
  <!-- matches. Instead, tint the loading_image texture pure black: -->
  <!-- whatever background the game picks renders as solid black.   -->
  <!-- Tips text and the progress bar are separate elements and     -->
  <!-- stay visible. Safety net on top of loadingscreen.xml and     -->
  <!-- LoadingScreenPatch.cs.                                       -->
  <!-- ============================================================ -->

  <set xpath="/windows/window[@name='loadingScreen']/texture[@name='loading_image']/@color">0,0,0,255</set>

  <!-- ============================================================ -->
  <!-- 7 Days For Kids — Main Menu Background                       -->
  <!-- V3.x main menu plays /Video/MenuBackground in a loop (shows  -->
  <!-- a zombie eating a person). Remove the video and the fallback -->
  <!-- art texture: only the solid black sprite remains. No game    -->
  <!-- code looks these elements up by name, so removal is safe.    -->
  <!-- ============================================================ -->

  <remove xpath="/windows/window[@name='menuBackground']/video[@name='videoTexture']"/>
  <remove xpath="/windows/window[@name='menuBackground']/texture[@name='bgTexture']"/>

</configs>
